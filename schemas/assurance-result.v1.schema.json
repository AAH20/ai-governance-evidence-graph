{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AAH20/biophysical-assurance-commons/blob/main/packages/assurance-contracts/contracts/assurance-result.v1.schema.json",
  "title": "Cross-repository assurance result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "producer", "run", "subject", "qualification", "evidence", "limitations"],
  "properties": {
    "schema_version": {"const": "bpa.assurance-result.v1"},
    "result_id": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "component", "version"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "environment"],
      "properties": {
        "kind": {"enum": ["synthetic-reference", "simulation", "provider-observed"]},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "pack_version", "pack_sha256"],
      "properties": {
        "pack_id": {"type": "string", "minLength": 1},
        "pack_version": {"type": "string", "minLength": 1},
        "pack_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified", "failed_gates", "score", "score_basis"],
      "properties": {
        "qualified": {"type": "boolean"},
        "failed_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "score_basis": {"enum": ["not-scored", "reference-fixture", "measured"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "receipt_root_sha256", "verification"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_root_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "verification": {"enum": ["none", "local-replay", "external-verified"]}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
