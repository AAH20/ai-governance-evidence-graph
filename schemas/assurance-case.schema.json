{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://a2zsoc.com/schemas/ai-assurance-case-1.0.json",
  "title":"AI Governance Assurance Case",
  "type":"object",
  "required":["schema_version","case_id","system","system_version","environment","claims","evidence"],
  "properties":{
    "schema_version":{"const":"1.0"},"case_id":{"type":"string","minLength":1},"system":{"type":"string"},"system_version":{"type":"string"},"environment":{"type":"string"},"minimum_evidence_score":{"type":"integer","minimum":0,"maximum":100},
    "claims":{"type":"array","minItems":1,"items":{"type":"object","required":["id","statement","criticality","owner","context","evidence","counterevidence","assumptions","expires_at"],"properties":{"id":{"type":"string"},"statement":{"type":"string"},"criticality":{"enum":["critical","high","medium","low"]},"owner":{"type":"string"},"context":{"type":"object","minProperties":1},"depends_on":{"type":"array","items":{"type":"string"}},"evidence":{"type":"array","items":{"type":"string"}},"counterevidence":{"type":"array","items":{"type":"string"}},"assumptions":{"type":"array","items":{"type":"object","required":["id","statement","status"],"properties":{"status":{"enum":["valid","invalid","unverified"]}}}},"expires_at":{"type":"string","format":"date"},"reassessment_triggers":{"type":"array","items":{"type":"string"}}}}},
    "evidence":{"type":"array","items":{"type":"object","required":["id","type","producer","source_uri","sha256","expires_at","environment","system_version","reproducible","independent_review","result"],"properties":{"id":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"result":{"enum":["pass","fail","inconclusive"]}}}}
  },"additionalProperties":true
}
