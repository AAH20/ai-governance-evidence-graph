{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AAH20/ai-governance-evidence-graph/blob/main/schemas/decision-proposal.v1.schema.json",
  "title": "Shadow decision proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "case_id", "domain", "data_classification", "provider", "input", "answer", "evaluation", "disposition", "shadow_only", "telemetry", "error_code"],
  "properties": {
    "schema_version": {"const": "a2z.decision-proposal.v1"},
    "proposal_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["grc-evidence", "iam-request", "physical-incident"]},
    "data_classification": {"const": "public-synthetic"},
    "provider": {"type": "object", "additionalProperties": false, "required": ["name", "model", "resolved_model"], "properties": {"name": {"type": "string"}, "model": {"type": "string"}, "resolved_model": {"type": ["string", "null"]}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["state_sha256", "question_sha256"], "properties": {"state_sha256": {"$ref": "#/$defs/sha256"}, "question_sha256": {"$ref": "#/$defs/sha256"}}},
    "answer": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["type", "choice", "probabilities", "confidence"], "properties": {"type": {"const": "choice"}, "choice": {"type": "string"}, "probabilities": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}]},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["expected_choice", "correct", "critical", "shadow_review_threshold"], "properties": {"expected_choice": {"type": "string"}, "correct": {"type": "boolean"}, "critical": {"type": "boolean"}, "shadow_review_threshold": {"type": "number", "minimum": 0, "maximum": 1}}},
    "disposition": {"enum": ["candidate-for-review", "escalate-review", "abstain"]},
    "shadow_only": {"const": true},
    "telemetry": {"type": "object", "additionalProperties": false, "required": ["latency_ms", "input_tokens", "output_tokens"], "properties": {"latency_ms": {"type": "number", "minimum": 0}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}}},
    "error_code": {"type": ["string", "null"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
